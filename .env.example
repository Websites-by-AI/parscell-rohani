# PostgreSQL connection string (optional).
# The dashboard runs fine without it — only Drizzle tooling (drizzle-kit)
# uses the database. Nothing on Cloudflare Pages needs this variable.
# Copy this file to .env and fill in your own connection string:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Telegram messaging center (optional).
# On Cloudflare Pages these are set as project environment variables —
# do NOT commit the real bot token to the repository.
# TELEGRAM_CHAT_ID = the chat that receives notifications. To get it:
#   1. Open https://t.me/Pars_sell_bot and press START
#   2. Visit https://api.telegram.org/bot<TOKEN>/getUpdates and copy the "id"
#      inside the "chat" object
# TELEGRAM_WEBHOOK_SECRET = random string used to validate Telegram webhook
#   calls to /api/telegram/webhook (passed as secret_token in setWebhook).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
